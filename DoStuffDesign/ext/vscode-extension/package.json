{
  "name": "dostuff",
  "displayName": "DoStuff: Issue Board",
  "description": "A lightweight issue tracker that lives in your editor. Sidebar list, full-tab Kanban board, JSON import/export.",
  "version": "1.0.0",
  "publisher": "your-name",
  "engines": { "vscode": "^1.84.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:dostuff.openBoard",
    "onCommand:dostuff.newIssue",
    "onCommand:dostuff.exportJson",
    "onCommand:dostuff.importJson",
    "onCommand:dostuff.focusSearch",
    "onCommand:dostuff.mcp.toggle",
    "onCommand:dostuff.mcp.editInstructions",
    "onView:dostuff.sidebar",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dostuff",
          "title": "DoStuff: Issues",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dostuff": [
        {
          "type": "webview",
          "id": "dostuff.sidebar",
          "name": "Issues",
          "icon": "media/icon.svg",
          "contextualTitle": "DoStuff"
        }
      ]
    },
    "commands": [
      { "command": "dostuff.openBoard",   "title": "Show Board",                  "category": "DoStuff", "icon": "$(layout)" },
      { "command": "dostuff.newIssue",    "title": "New Issue…",                  "category": "DoStuff", "icon": "$(add)" },
      { "command": "dostuff.exportJson",  "title": "Export Issues (JSON)…",       "category": "DoStuff", "icon": "$(cloud-download)" },
      { "command": "dostuff.importJson",  "title": "Import Issues (JSON)…",       "category": "DoStuff", "icon": "$(cloud-upload)" },
      { "command": "dostuff.focusSearch", "title": "Focus Search",                "category": "DoStuff" },
      { "command": "dostuff.mcp.toggle",            "title": "Toggle MCP Server",              "category": "DoStuff" },
      { "command": "dostuff.mcp.editInstructions",  "title": "Edit MCP Workflow Instructions…", "category": "DoStuff" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "dostuff.openBoard" },
        { "command": "dostuff.newIssue" },
        { "command": "dostuff.exportJson" },
        { "command": "dostuff.importJson" },
        { "command": "dostuff.focusSearch" },
        { "command": "dostuff.mcp.toggle" },
        { "command": "dostuff.mcp.editInstructions" }
      ],
      "view/title": [
        { "command": "dostuff.newIssue",   "when": "view == dostuff.sidebar", "group": "navigation@1" },
        { "command": "dostuff.openBoard",  "when": "view == dostuff.sidebar", "group": "navigation@2" },
        { "command": "dostuff.importJson", "when": "view == dostuff.sidebar", "group": "navigation@3" },
        { "command": "dostuff.exportJson", "when": "view == dostuff.sidebar", "group": "navigation@4" }
      ]
    },
    "keybindings": [
      { "command": "dostuff.newIssue",    "key": "ctrl+shift+i", "mac": "cmd+shift+i" },
      { "command": "dostuff.focusSearch", "key": "ctrl+shift+f", "mac": "cmd+shift+f", "when": "focusedView == dostuff.sidebar" }
    ],
    "configuration": {
      "title": "DoStuff",
      "properties": {
        "dostuff.storageMode": {
          "type": "string",
          "enum": ["json-files", "sqlite"],
          "default": "json-files",
          "description": "How issues are persisted. 'json-files' = one .json per issue in the storage path. 'sqlite' = single .db file (requires sqlite binding)."
        },
        "dostuff.storagePath": {
          "type": "string",
          "default": ".vscode/dostuff",
          "description": "Folder (relative to workspace root) where issue JSON files are stored. Ignored when storageMode is 'sqlite'."
        },
        "dostuff.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Persist edits automatically as you type."
        },
        "dostuff.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Run an in-process MCP server that exposes the active ticket queue to local agents."
        },
        "dostuff.mcp.port": {
          "type": "number",
          "default": 3947,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Localhost port the MCP server listens on. Endpoint is http://127.0.0.1:<port>/mcp."
        },
        "dostuff.mcp.instructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "scope": "application",
          "markdownDescription": "System-level workflow prompt served alongside every ticket. Leave blank to use the built-in default. Only configurable at the user (application) level \u2014 not per-workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch":   "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/node":   "^20.0.0",
    "typescript":    "^5.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod":                        "^3.23.0"
  }
}
