{
  "name": "dostuff",
  "displayName": "DoStuff",
  "description": "Simple software issue board with an MCP server for agent integration",
  "version": "0.1.0",
  "main": "./dist/extension.cjs",
  "module": "index.ts",
  "type": "module",
  "engines": {
    "vscode": "^1.86.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOURNAME"
  },
  "scripts": {
    "dev": "echo 'Open this directory in VSCode and then run your extension with F5 or `Run and Debug > Run Extension`!'",
    "build": "bun run ./scripts/build-with-esbuild.ts",
    "watch": "bun run ./scripts/watch-with-esbuild.ts",
    "vsce-package": "bun run vsce package",
    "package": "bun run build && bun run vsce-package",
    "clean": "rm -rf ./dist ./media/index.js ./media/index.js.map ./media/styles.css ./media/styles.css.map"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/vscode": "^1.86.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-window": "^1.8.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vscode/vsce": "^2.23.0",
    "esbuild": "^0.20.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dostuff.openBoard",
    "onCommand:dostuff.newIssue",
    "onView:dostuff.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dostuff",
          "title": "DoStuff: Issues",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dostuff": [
        {
          "type": "webview",
          "id": "dostuff.sidebar",
          "name": "Issues",
          "icon": "media/icon.svg",
          "contextualTitle": "DoStuff"
        }
      ]
    },
    "commands": [
      {
        "command": "dostuff.openBoard",
        "title": "Show Board",
        "category": "DoStuff",
        "icon": "$(layout)"
      },
      {
        "command": "dostuff.newIssue",
        "title": "New Issue…",
        "category": "DoStuff",
        "icon": "$(add)"
      },
      {
        "command": "dostuff.exportJson",
        "title": "Export Issues (JSON)…",
        "category": "DoStuff",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dostuff.importJson",
        "title": "Import Issues (JSON)…",
        "category": "DoStuff",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dostuff.focusSearch",
        "title": "Focus Search",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.mcp.toggle",
        "title": "Toggle MCP Server",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.mcp.editInstructions",
        "title": "Edit MCP Workflow Instructions…",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.openSettings",
        "title": "Settings",
        "category": "DoStuff",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dostuff.openBoard"
        },
        {
          "command": "dostuff.newIssue"
        },
        {
          "command": "dostuff.exportJson"
        },
        {
          "command": "dostuff.importJson"
        },
        {
          "command": "dostuff.focusSearch"
        },
        {
          "command": "dostuff.mcp.toggle"
        },
        {
          "command": "dostuff.mcp.editInstructions"
        }
      ],
      "view/title": [
        {
          "command": "dostuff.newIssue",
          "when": "view == dostuff.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "dostuff.openBoard",
          "when": "view == dostuff.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "dostuff.importJson",
          "when": "view == dostuff.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "dostuff.exportJson",
          "when": "view == dostuff.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "dostuff.openSettings",
          "when": "view == dostuff.sidebar",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dostuff.newIssue",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "dostuff.focusSearch",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "focusedView == dostuff.sidebar"
      }
    ],
    "configuration": {
      "title": "DoStuff",
      "properties": {
        "dostuff.storagePath": {
          "type": "string",
          "default": ".vscode/dostuff",
          "description": "Folder (relative to workspace root) where issue JSON files are stored."
        },
        "dostuff.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Persist edits automatically as you type."
        },
        "dostuff.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Run an in-process MCP server that exposes the active ticket queue to local agents."
        },
        "dostuff.mcp.port": {
          "type": "number",
          "default": 3947,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Localhost port the MCP server listens on. Endpoint is http://127.0.0.1:<port>/mcp."
        },
        "dostuff.mcp.instructions": {
          "type": "string",
          "default": "You are working from the DoStuff issue board. Tickets in 'Planned', 'Working', or 'Testing' are servable. Use get_ticket to fetch a ticket, then update_ticket_status to move it through the workflow (Planned -> Working -> Testing). Use update_ticket_progress to check off tasks and append progress notes as you work. Do not move tickets back to 'Thinking' (human triage only) or to 'Complete' (human approval only). Each active lane is capped at 6 tickets; a move that would exceed the cap will be rejected.",
          "editPresentation": "multilineText",
          "scope": "application",
          "markdownDescription": "System-level workflow prompt served alongside every ticket. Leave blank to use the built-in default. Only configurable at the user (application) level — not per-workspace."
        }
      }
    }
  }
}
