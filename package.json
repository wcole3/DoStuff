{
  "name": "dostuff",
  "displayName": "DoStuff",
  "publisher": "wcole3",
  "license": "MIT",
  "icon": "media/dostuff-icon-sm.png",
  "description": "Simple software issue board with an MCP server for agent integration",
  "version": "1.0.1",
  "main": "./dist/extension.cjs",
  "module": "index.ts",
  "type": "module",
  "engines": {
    "vscode": "^1.86.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wcole3/DoStuff"
  },
  "scripts": {
    "dev": "echo 'Open this directory in VSCode and then run your extension with F5 or `Run and Debug > Run Extension`!'",
    "build": "bun run ./scripts/build-with-esbuild.ts",
    "watch": "bun run ./scripts/watch-with-esbuild.ts",
    "vsce-package": "bun run vsce package --no-dependencies",
    "package": "bun run build && bun run vsce-package",
    "clean": "rm -rf ./dist ./media/index.js ./media/index.js.map ./media/styles.css ./media/styles.css.map"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/vscode": "^1.120.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "sql.js": "^1.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@types/sql.js": "^1.4.11",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dostuff.openBoard",
    "onCommand:dostuff.newIssue",
    "onView:dostuff.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dostuff",
          "title": "DoStuff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dostuff": [
        {
          "type": "webview",
          "id": "dostuff.sidebar",
          "name": "Issues",
          "icon": "media/icon.svg",
          "contextualTitle": "DoStuff"
        }
      ]
    },
    "commands": [
      {
        "command": "dostuff.openBoard",
        "title": "Show Board",
        "category": "DoStuff",
        "icon": "$(layout)"
      },
      {
        "command": "dostuff.newIssue",
        "title": "New Issue…",
        "category": "DoStuff",
        "icon": "$(add)"
      },
      {
        "command": "dostuff.exportJson",
        "title": "Export Issues (JSON)…",
        "category": "DoStuff",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dostuff.importJson",
        "title": "Import Issues (JSON)…",
        "category": "DoStuff",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dostuff.focusSearch",
        "title": "Focus Search",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.mcp.toggle",
        "title": "Toggle MCP Server",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.mcp.editInstructions",
        "title": "Edit MCP Workflow Instructions…",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.mcp.pinPort",
        "title": "Pin MCP Port to Workspace",
        "category": "DoStuff"
      },
      {
        "command": "dostuff.openSettings",
        "title": "Settings",
        "category": "DoStuff",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dostuff.clearAll",
        "title": "Clear All Issues…",
        "category": "DoStuff",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dostuff.openBoard"
        },
        {
          "command": "dostuff.newIssue"
        },
        {
          "command": "dostuff.exportJson"
        },
        {
          "command": "dostuff.importJson"
        },
        {
          "command": "dostuff.focusSearch"
        },
        {
          "command": "dostuff.mcp.toggle"
        },
        {
          "command": "dostuff.mcp.editInstructions"
        },
        {
          "command": "dostuff.mcp.pinPort"
        },
        {
          "command": "dostuff.clearAll"
        }
      ],
      "view/title": [
        {
          "command": "dostuff.newIssue",
          "when": "view == dostuff.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "dostuff.openBoard",
          "when": "view == dostuff.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "dostuff.importJson",
          "when": "view == dostuff.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "dostuff.exportJson",
          "when": "view == dostuff.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "dostuff.openSettings",
          "when": "view == dostuff.sidebar",
          "group": "navigation@5"
        },
        {
          "command": "dostuff.clearAll",
          "when": "view == dostuff.sidebar",
          "group": "navigation@6"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dostuff.newIssue",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      }
    ],
    "configuration": {
      "title": "DoStuff",
      "properties": {
        "dostuff.storagePath": {
          "type": "string",
          "default": ".vscode/dostuff",
          "description": "Folder (relative to workspace root) where issue JSON files are stored."
        },
        "dostuff.writeStorageGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Write a .gitignore file inside the storage folder so ticket JSON files are not committed when .vscode/ is tracked."
        },
        "dostuff.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Persist edits automatically as you type."
        },
        "dostuff.activeLaneCap": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of tickets allowed in each active lane (Planned, Working, Verification). Enforced by the UI, host, and MCP server."
        },
        "dostuff.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Run an in-process MCP server that exposes the active ticket queue to local agents."
        },
        "dostuff.mcp.workspaceOverride": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Absolute path to advertise in the multi-workspace registry. Leave blank to use the first workspace folder. Useful when agents run from a subdirectory of a different tree."
        },
        "dostuff.mcp.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "scope": "window",
          "markdownDescription": "Localhost port for this workspace's MCP server. `0` (default) lets the OS pick an ephemeral port each session. Set a fixed value (1024–65535) to keep `mcp.json` URLs stable across restarts. Easiest way to set this: run **DoStuff: Pin MCP Port to Workspace** while the server is running. If the chosen port is already in use, the server falls back to an ephemeral one."
        },
        "dostuff.mcp.instructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "scope": "application",
          "markdownDescription": "System-level workflow prompt served alongside every ticket. Leave blank to use the built-in default. Only configurable at the user (application) level — not per-workspace."
        }
      }
    }
  }
}
